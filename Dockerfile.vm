# Build Stage
FROM --platform=linux/arm64 mcr.microsoft.com/dotnet/sdk:8.0 AS build-env
WORKDIR /src

# Telerik: NuGet feed key for restore, license key so the build embeds a non-trial license.
# Pass on the build command, e.g.
#   docker build -f Dockerfile.vm \
#     --build-arg TELERIK_NUGET_KEY="$TELERIK_NUGET_KEY" \
#     --build-arg TELERIK_LICENSE="$(cat ~/.telerik/telerik-license.txt)" ...
ARG TELERIK_NUGET_KEY
ARG TELERIK_LICENSE
ENV TELERIK_NUGET_KEY=$TELERIK_NUGET_KEY
ENV TELERIK_LICENSE=$TELERIK_LICENSE

COPY ./Contracts.sln ./
COPY ./nuget.config ./
COPY ./API/API.csproj ./API/
COPY ./Application/Application.csproj ./Application/
COPY ./Infrastructure/Infrastructure.csproj ./Infrastructure/
COPY ./Domain/Domain.csproj ./Domain/
COPY ./Persistence/Persistence.csproj ./Persistence/
RUN dotnet restore
RUN dotnet tool install --global dotnet-ef --version 8.0.8
ENV PATH="$PATH:/root/.dotnet/tools"
COPY . .
COPY ./API/Json ./API/Json
ENV TokenKey=lWwMN68UKbjuEJAAYq9ke9KYtPrabUTE9kghtxPrysPDfgaezEyfV3gjoA4F90TYcgYRhH5wXC0XhR5idy1n0w==
ENV ASPNETCORE_URLS=http://0.0.0.0:5100;https://0.0.0.0:8544
ENV ASPNETCORE_ENVIRONMENT=Production
RUN dotnet publish ./API/API.csproj -c Release -o /app/ --no-restore

# Runtime Stage
FROM --platform=linux/arm64 mcr.microsoft.com/dotnet/aspnet:8.0.20-bookworm-slim AS runtime
WORKDIR /app
COPY --from=build-env /app .
COPY --from=build-env /src/API/Json ./Json
COPY API/appsettings.json /app/appsettings.json
COPY API/appsettings.*.json /app/

 RUN mkdir -p /app/logs
 
# REFACTOR: Ensure OpenSSL is available by installing it explicitly to handle certificate loading.
# fontconfig + font faces: Telerik Reporting renders text through SkiaSharp and needs real
# font files present (unlike the old QuestPDF engine, which shipped its own). fonts-noto-core covers Latin;
# add an Arabic naskh face here (Amiri / Cairo / Noto Naskh Arabic) once the report font is fixed.
RUN apt-get update && apt-get install -y --no-install-recommends \
      openssl libfontconfig1 libfreetype6 fontconfig fonts-noto-core libuuid1 \
 && rm -rf /var/lib/apt/lists/* \
 && fc-cache -f

# SkiaSharp 3.119 linux-arm64 libSkiaSharp.so is a broken native build: unlike the x64 one it
# statically embeds fontconfig, yet leaves exactly five externals unresolved and declares NO
# NEEDED library for them — uuid_generate_random/uuid_copy/uuid_parse/uuid_unparse (libuuid)
# and FT_Get_BDF_Property (libfreetype). The first Telerik render then kills the whole process:
#   dotnet: symbol lookup error: .../libSkiaSharp.so: undefined symbol: uuid_generate_random
# (no managed exception, nothing in Serilog, container just restarts). Preloading both libs
# puts those symbols in the global scope so the lazy binding succeeds. Verified against the
# package's .dynsym — these five are the only non-glibc undefined symbols.
ENV LD_PRELOAD=/usr/lib/aarch64-linux-gnu/libuuid.so.1:/usr/lib/aarch64-linux-gnu/libfreetype.so.6

# Runtime license check (build already embedded one; this keeps parity if that changes).
ARG TELERIK_LICENSE
ENV TELERIK_LICENSE=$TELERIK_LICENSE
ENV ASPNETCORE_URLS=http://0.0.0.0:5100;https://0.0.0.0:8544
EXPOSE 5100
EXPOSE 8544
ENTRYPOINT ["dotnet", "API.dll"]