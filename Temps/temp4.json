# Build Stage
FROM --platform=linux/arm64 mcr.microsoft.com/dotnet/sdk:8.0 AS build-env
WORKDIR /src
COPY ./Contracts.sln ./
COPY ./API/API.csproj ./API/
COPY ./Application/Application.csproj ./Application/
COPY ./Infrastructure/Infrastructure.csproj ./Infrastructure/
COPY ./Domain/Domain.csproj ./Domain/
COPY ./Persistence/Persistence.csproj ./Persistence/
# REFACTOR: Restore dependencies early to leverage Docker caching
RUN dotnet restore
# REFACTOR: Install EF Core CLI tool for migration management
RUN dotnet tool install --global dotnet-ef --version 8.0.8
ENV PATH="$PATH:/root/.dotnet/tools"
COPY . .
# REFACTOR: Copy Json directory from API project for seeding
COPY ./API/Json ./API/Json
ENV TokenKey=lWwMN68UKbjuEJAAYq9ke9KYtPrabUTE9kghtxPrysPDfgaezEyfV3gjoA4F90TYcgYRhH5wXC0XhR5idy1n0w==
ENV ASPNETCORE_URLS=http://0.0.0.0:5100;https://0.0.0.0:8544
ENV ASPNETCORE_ENVIRONMENT=Production
# REFACTOR: Publish with no-restore to optimize build time
RUN dotnet publish ./API/API.csproj -c Release -o /app/ --no-restore

# Runtime Stage
FROM --platform=linux/arm64 mcr.microsoft.com/dotnet/aspnet:8.0.20-bookworm-slim AS runtime
WORKDIR /app
COPY --from=build-env /app .
# REFACTOR: Copy Json directory from API project to runtime image for seeding
COPY --from=build-env /src/API/Json ./Json
COPY API/appsettings.json /app/appsettings.json
COPY API/appsettings.*.json /app/
# REFACTOR: Install OpenSSL for certificate handling and clean up to reduce image size
RUN apt-get update && apt-get install -y openssl && rm -rf /var/lib/apt/lists/*
ENV ASPNETCORE_URLS=http://0.0.0.0:5100;https://0.0.0.0:8544
EXPOSE 5100
EXPOSE 8544
ENTRYPOINT ["dotnet", "API.dll"]